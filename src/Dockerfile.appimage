FROM --platform=linux/amd64 debian:bookworm

RUN apt-get update && apt-get -y install git gcc make libncurses-dev libssl-dev xorg-dev libsdl1.2-dev libpulse-dev libsndfile1-dev libasound2-dev

# Nota: en debian 12 es libfuse2, en debian 13 seria libfuse2t64
RUN apt-get -y install wget file binutils patchelf squashfs-tools desktop-file-utils libfuse2

RUN wget https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage

# Workaround for AppImage ELF header incompatibility with Docker emulation
# Esto pasa por usar Docker en Mac silicon, con contenedor x86_64
# El kernel de docker realmente es arm64 y hay un problema con esos bytes, porque son para identificar el ejecutable de appimage,
# pero el cargador del kernel (que es arm64) lo rechaza
RUN dd if=/dev/zero bs=1 count=3 seek=8 conv=notrunc \
    of=/linuxdeploy-x86_64.AppImage

RUN chmod +x linuxdeploy-x86_64.AppImage

ENV CFLAGS "-O3"
ENV LDFLAGS "-O3"

RUN git clone https://github.com/chernandezba/zesarux.git && cd zesarux/src && ./configure --enable-ssl --enable-appimage --enable-docker --disable-caca --disable-aa --disable-cursesw --prefix /usr && make clean && make -j2

# Se usa APPIMAGE_EXTRACT_AND_RUN porque necesitariamos Fuse pero no está disponible en docker
RUN cd /zesarux/src && APPIMAGE_EXTRACT_AND_RUN=1 make appimage

# Nota: el binario generado no va en docker por la misma razon que linuxdeploy. Dejamos un binario temporal con la cabecera corregida para poderlo iniciar
RUN cd /zesarux/src && cp ZEsarUX-x86_64.AppImage /tmp/ZEsarUX-test.AppImage
RUN dd if=/dev/zero bs=1 count=3 seek=8 conv=notrunc of=/tmp/ZEsarUX-test.AppImage


WORKDIR /

ENV APPIMAGE_EXTRACT_AND_RUN=1

ENTRYPOINT ["/tmp/ZEsarUX-test.AppImage"]


CMD [ "--vo" , "stdout", "--ao" , "null" ]
